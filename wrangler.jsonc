{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cade-work",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "cade.work", "custom_domain": true },
    { "pattern": "www.cade.work", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
