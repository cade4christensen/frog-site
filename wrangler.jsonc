{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cade-work",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "cade.work", "custom_domain": true },
    { "pattern": "www.cade.work", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
